<?xml version="1.0" encoding="utf-8"?>
<!-- Lối tắt "Mở Gemini" bên trong HiGG: nhấn giữ biểu tượng HiGG, hoặc chọn cho Nút lối tắt của vivo. -->
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut
        android:shortcutId="open_gemini"
        android:enabled="true"
        android:icon="@mipmap/ic_launch_gemini"
        android:shortcutShortLabel="@string/launch_gemini"
        android:shortcutLongLabel="@string/launch_gemini">
        <intent
            android:action="android.intent.action.VIEW"
            android:targetPackage="com.higg"
            android:targetClass="com.higg.LaunchGeminiActivity" />
    </shortcut>
</shortcuts>
